# X4 Pro — board-specific sdkconfig (layered after the common sdkconfig.defaults)
# Hardware: ESP32-S3R8, 16 MB quad flash, 8 MB octal PSRAM.
# Pinout and drivers: docs/hardware-specs.md (bring-up validated 2026-09-13).

# Board-specific partition table (path relative to the project root).
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="boards/x4pro/partitions.csv"

# Required by power_mgr_switch_to_factory() (2026-09-16, ADR-009 amended):
# the app writes/erases the otadata backup sector @0xB000, before the
# first partition (NVS @0xD000) -> "dangerous" by default. Same contract
# as boards/x4pro/factory/sdkconfig.defaults (hooks.c bootloader).
CONFIG_SPI_FLASH_DANGEROUS_WRITE_ALLOWED=y

# LVGL (boards/x4pro/app only, ADR-010 amended again — see idf_component.yml):
# 1bpp color depth matches the e-ink panel's native 1bpp framebuffer and
# auto-selects LV_USE_THEME_MONO ("suitable for some E-paper & dot matrix
# displays", lvgl's own Kconfig help text) instead of the default/simple
# themes' gradients and shadows, which have no meaning on this panel.
CONFIG_LV_COLOR_DEPTH_1=y

# Fonts (2026-10-10): the app uses its own msf_font_24 (default, ~24px:
# LVGL's 14 reads as tiny on this 480x800 panel, 2026-09-21) and msf_font_32
# (larger glyphs), generated by tools/gen_fonts.py = the built-in Montserrat
# 24/32 plus extra Font Awesome icons (lock, lock-open). The built-in 24/32
# are therefore off (no duplicate in flash). LVGL's Kconfig default-font
# choice can only name a built-in font: it stays Montserrat 14, and the
# root CMakeLists overrides LV_FONT_DEFAULT with &msf_font_24.
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_14=y
# CONFIG_LV_FONT_MONTSERRAT_24 is not set
# CONFIG_LV_FONT_MONTSERRAT_32 is not set

# LVGL's builtin 64KB pool (internal DRAM) ran out once the Time screen's
# ~50 keyboard keys were built (2026-09-24: LV_ASSERT_MALLOC in
# get_local_style -> task watchdog loop at boot). Use the C allocator
# instead: small blocks stay in internal RAM, larger ones spill to the
# 8MB PSRAM (CONFIG_SPIRAM_USE_MALLOC).
CONFIG_LV_USE_CLIB_MALLOC=y

# BLE time sync (ADR-006): NimBLE central only (scan, connect, read the
# Current Time Service), one connection at a time. Peripheral/broadcaster
# roles are off to save flash and RAM.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
# CONFIG_BT_NIMBLE_ROLE_PERIPHERAL is not set
# CONFIG_BT_NIMBLE_ROLE_BROADCASTER is not set
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1

# Internal RAM is scarce (2026-09-25: BLE init failed with only ~50KB
# internal heap left, largest block 21KB, "hci inits failed"). LVGL
# (C allocator) and the app's own small allocations were filling it. Prefer
# PSRAM for malloc() at any size (DMA/ISR-critical drivers use explicit
# internal caps, and CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL keeps a reserve),
# and put NimBLE's host allocations in PSRAM too.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y

# CPU at 240 MHz (2026-10-10; was ESP-IDF's S3 default, 160): Argon2id PIN
# unlock (ADR-004), LVGL and TOTP ~1.5x faster. The extra power only applies
# while awake (minutes per use); deep sleep, where the device spends almost
# all its time, does not depend on it.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# SD backups (P11): long file names, MSF-20261011-1530.msfx is not 8.3.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# USB disk mode (usb_disk.c, 2026-10-17): the SD card as a USB mass-storage
# disk via espressif/esp_tinyusb, MSC only (no CDC: the console stays on
# USB-Serial/JTAG outside a USB disk session). Strings shown by the PC.
CONFIG_TINYUSB_MSC_ENABLED=y
# CONFIG_TINYUSB_CDC_ENABLED is not set
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="MySafeFob"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="MySafeFob SD card"
CONFIG_TINYUSB_DESC_SERIAL_STRING=""
CONFIG_TINYUSB_DESC_MSC_STRING="MySafeFob SD card"
